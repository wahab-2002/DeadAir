  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableNote
  viewer: {fileID: 1417538498}
  text: "1. Hide till everyone leaves.\n2. Meet on the CAFETERIA STAGE at 10.\n3.
    Catch the Knocking Ghost on tape (it knocks in the walls on Halloween!!).\n4.
    Radios on channel 3. Knock code: 1 = YES, 2 = NO, 3 = COME FIND ME.\n5. Cover
    story: you're at my house, I'm at yours.\n6. Whoever chickens out has to SAY
    IT on the radio.\n\u2014 Lou + Sam"
