--- !u!114 &1892682199
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1892682198}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993ca74ca73c141cab875183599c10ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RadioChannel
  state: 0
  captions: {fileID: 1417538499}
  notes: {fileID: 1417538498}
  player: {fileID: 1847013422}
  view: {fileID: 1424814113}
  crate: {fileID: 1024631569}
  samVoice: {fileID: 1335939006}
  samFeed: {fileID: 668334931}
  controls: {fileID: 1778908728}
  radioFourVoice: {fileID: 1974271247}
  radioFourFeed: {fileID: 908910266}
  txLight: {fileID: 730076716}
  rxLight: {fileID: 609711202}
  replyWait: 15
  captionInterval: 20
  echoDelay: 0.15
  feedbackDistance: 1.5
  secondsPerCharacter: 0.06
  lines:
  - role: sam_dead_air
    speaker: 'SAM:'
    text: Lou? I fell asleep. Are you there? Over.
    clip: {fileID: 0}
  - role: lou_line_00
    speaker: 'LOU (radio):'
    text: "\u2014am? Sam, please. Anyone. Over."
    clip: {fileID: 0}
  - role: sam_line_01
    speaker: 'SAM:'
    text: Lou! It's me! I fell asleep. Where are you?
    clip: {fileID: 0}
  - role: lou_line_01
    speaker: 'LOU (radio):'
    text: Sam?! I've been calling for hours. I hid to jump out at you, and then I
      was falling, and now it's pitch black. I don't know where I am. My flashlight
      broke.
    clip: {fileID: 0}
  - role: sam_line_02
    speaker: 'SAM:'
    text: What's down there with you?
    clip: {fileID: 0}
  - role: lou_line_02
    speaker: 'LOU (radio):'
    text: Boxes, I think. Sheets. And something laughs every time I move.
    clip: {fileID: 0}
  - role: lou_that
    speaker: 'LOU (radio):'
    text: That!
    clip: {fileID: 0}
  - role: lou_line_03
    speaker: 'LOU (radio):'
    text: My batteries are almost dead. I'm gonna hold the button down so you can
      hear what I hear. Find me. Please find me.
    clip: {fileID: 0}
  testLines:
  - role: lou_radiator_first
    speaker: 'LOU (radio):'
    text: Was that you? I heard it in the pipe... but it's everywhere.
    clip: {fileID: 0}
  - role: lou_radiator_later
    speaker: 'LOU (radio):'
    text: I hear you. Keep going.
    clip: {fileID: 0}
  - role: lou_door_thud
    speaker: 'LOU (radio):'
    text: That was far away.
    clip: {fileID: 0}
  - role: lou_witch_echo
    speaker: 'LOU (radio):'
    text: The laugh again... no, that one sounded different. Closer.
    clip: {fileID: 0}
  - role: lou_battery_last
    speaker: 'LOU (radio):'
    text: "That! That's right next to me! Sam, I think that's what I fell out of...
      the light's blinking... please don't leave me down h\u2014"
    clip: {fileID: 0}
  - role: sam_silent_call
    speaker: 'SAM:'
    text: Lou? Lou, can you hear me?
    clip: {fileID: 0}
